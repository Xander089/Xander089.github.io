---
import { site } from '../site';

interface Props {
  title: string;
  description?: string;
  nav?: { href: string; label: string }[];
}
const {
  title,
  description = `${site.name}, ${site.title}. Portfolio of Unreal Engine and C++ projects.`,
  nav = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a href="/" class="brand">{site.name}</a>
        {nav.length > 0 && (
          <nav aria-label="Sections">
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </nav>
        )}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span class="links">
        <a href={site.github}>GitHub</a>
        <a href={site.linkedin}>LinkedIn</a>
        <!-- <a href={`mailto:${site.email}`}>Email</a> -->
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbfa;
    --surface: #ffffff;
    --fg: #1d1d1f;
    --muted: #63636a;
    --line: #e3e3e0;
    --accent: #2f5bd3;
    --accent-soft: #e9eefc;
    --code-bg: #f4f4f2;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141416;
      --surface: #1b1b1e;
      --fg: #ececef;
      --muted: #9d9da6;
      --line: #2b2b31;
      --accent: #8aa6ff;
      --accent-soft: #1f2640;
      --code-bg: #1e1e22;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 4.5rem; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.65 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  main, .site-footer, .site-header .inner {
    max-width: 52rem;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
  }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.25; }
  code { font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: 0.9em; }
  :not(pre) > code { background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 4px; }
  pre { padding: 1rem; border-radius: 8px; overflow-x: auto; font-size: 0.85rem; line-height: 1.5; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .site-header .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }
  .brand { font-weight: 650; color: var(--fg); text-decoration: none; }
  .site-header nav { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.92rem; }
  .site-header nav a { color: var(--muted); text-decoration: none; }
  .site-header nav a:hover { color: var(--fg); }

  .site-footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .site-footer .links { display: flex; gap: 1rem; }
</style>
